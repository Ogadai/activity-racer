# Copy this file to `packages/frontend/.env.local` (gitignored) for local Vite development.
# Populate these PUBLIC client identifiers from your `ActivityRacerStack` CDK outputs
# (or from your deployed site's `/config.json`).
#
# Never put secrets (such as your Google OAuth Client Secret) in frontend `.env` files.

VITE_API_URL=https://<your-api-id>.execute-api.eu-north-1.amazonaws.com/api
VITE_AWS_REGION=eu-north-1
VITE_USER_POOL_ID=eu-north-1_<your-user-pool-id>
VITE_USER_POOL_CLIENT_ID=<your-spa-client-id>
VITE_COGNITO_DOMAIN=https://activity-racer-<your-aws-account-id>.auth.eu-north-1.amazoncognito.com
VITE_GOOGLE_AUTH_ENABLED=true
